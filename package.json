{
	"name": "scraper-worker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --test-scheduled --port 8009 --persist-to ../event-tracker/.wrangler/state",
		"cf-typegen": "wrangler types",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare:husky": "husky"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.9",
		"@eslint/js": "^9.26.0",
		"drizzle-kit": "^0.31.1",
		"eslint": "^9.26.0",
		"eslint-config-prettier": "^10.1.5",
		"globals": "^16.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.0.0",
		"prettier": "^3.5.3",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.32.1",
		"wrangler": "^4.15.1"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"!(*.{js,ts,svelte})": [
			"prettier --write --ignore-unknown"
		]
	},
	"dependencies": {
		"date-fns-tz": "^3.2.0",
		"drizzle-orm": "^0.43.1",
		"us-state-converter": "^1.0.8"
	}
}
